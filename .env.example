# ============================================================
#  Example environment file — COPY this to ".env" and edit.
#  NEVER commit the real ".env" (it is ignored by .gitignore).
# ============================================================

# ---------- Django backend ----------
# Long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- React frontend (Vite) ----------
# Base URL the browser uses to reach the Django API.
VITE_API_URL=http://127.0.0.1:8000/api
